# Copy to .env and adjust. Placeholders only — never commit real values.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Leave empty for local development; set a long random value anywhere else.
API_KEY=

# --- Database (SQLite for local dev, PostgreSQL in Docker / production) ---
DATABASE_URL=sqlite:///./dealscreener.db
# DATABASE_URL=postgresql://dealscreener:change-me@localhost:5432/dealscreener
POSTGRES_USER=dealscreener
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dealscreener

# --- Job queue (Redis optional locally; DB-backed queue is the fallback) ---
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=false
REDIS_DB_FALLBACK=true
REDIS_BLOCK_TIMEOUT=5
ASYNC_JOBS=false
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_TTL_SECONDS=120

# --- Storage ---
STORAGE_DIR=./storage
FILE_SIZE_LIMIT_MB=50
ALLOWED_FILE_TYPES=.pdf,.docx,.pptx,.txt,.md

# --- LLM (local Ollama) ---
# false = offline extraction mode (no LLM); true = specialist agents call Ollama.
RUN_LIVE_LLM=false
MODEL_PROVIDER=ollama
OLLAMA_PRIMARY_BASE_URL=http://127.0.0.1:11434
OLLAMA_PRIMARY_MODEL=llama3.1:8b
OLLAMA_FALLBACK_BASE_URL=http://127.0.0.1:11434
OLLAMA_FALLBACK_MODEL=mistral
OLLAMA_PRIMARY_TIMEOUT=20
MODEL_TIMEOUT_SECONDS=120

# --- Deterministic scoring (illustrative defaults; see scoring_logic.py) ---
SCORING_VERSION=1.0.0
# SCORING_BASE_SCORE_DEFAULT=70
# SCORING_MISSING_VAR_PENALTY=3
# SCORING_RED_FLAG_PENALTY_EACH=8
# SCORING_THRESHOLD_YES=75
# SCORING_THRESHOLD_MAYBE=50
# SCORING_THRESHOLD_NEEDS_REVIEW=30

# --- Advanced pipeline: thesis matrix, ESG, simulation, IC memo, human review gate ---
ENABLE_ADVANCED_PIPELINE=true
SIMULATION_SEED=1337
SIMULATION_ITERATIONS=200
SIMULATION_HORIZON_YEARS=5
SYNTHETIC_COHORT_SIZE=25
REVIEW_CONFIDENCE_THRESHOLD=0.55
REVIEW_RESILIENCE_THRESHOLD=45.0

# --- Alerts (disabled by default; mock/log only when off) ---
SLACK_ALERTS_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_ALERT_CHANNEL=#deal-alerts

# --- Retraining loop ---
CLASSIFIER_MODEL_PATH=models/classifier.pkl
RETRAIN_MIN_REVIEWED_CASES=50
RETRAIN_DRY_RUN=false
